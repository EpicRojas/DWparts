---
/**
 * 筛选面板 —— 悬浮下拉式。
 *
 * 结构上是顶栏下方的一个浮层，覆盖主内容，收起时向上滑出（非线性缓动）。
 * 每个类别首位为「全部」，选中即清除该组条件。
 *
 * 两层结构（关键）：
 *   .filters         只负责毛玻璃与淡入淡出，绝不做几何动画
 *   .filters__panel  负责展开与收起的位移
 * 带 backdrop-filter 的元素一旦自己做 transform / clip-path 动画，
 * 浏览器会将其提升为独立合成层，该层的背景采样取不到下方内容，
 * 表现为动画全程保持锐利、结束才出现模糊。几何动画须下放至不含滤镜的子元素。
 */
import type { Taxonomy } from '../lib/taxonomy.ts';

interface Props { tax: Taxonomy }
const { tax } = Astro.props;
---
<div class="filters" id="filters" data-filters hidden>
  <div class="filters__panel">
    <div class="filters__inner">
    {
      tax.groups.map((g) => (
        <div class="filter-row">
          <div class="filter-row__label">{g.label}</div>
          <div class="filter-row__values" role="group" aria-label={`按${g.label}筛选`}>
            <button
              class="chip chip--all"
              type="button"
              aria-pressed="true"
              data-group={g.id}
              data-value=""
              title={`不限${g.label}`}
            >
              <span>全部</span>
            </button>
            {g.values.map((v) => (
              <button
                class="chip"
                type="button"
                aria-pressed="false"
                data-group={g.id}
                data-value={v.id}
                title={v.label}
              >
                {v.icon && <img class="ico" src={`img/common/${v.icon}`} alt="" width="16" height="16" loading="lazy" decoding="async" />}
                <span>{v.label}</span>
              </button>
            ))}
          </div>
        </div>
      ))
    }
    </div>
  </div>
</div>
